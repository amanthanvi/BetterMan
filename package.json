{
	"name": "betterman",
	"private": true,
	"packageManager": "pnpm@10.34.4",
	"scripts": {
		"convex:dev": "convex dev",
		"convex:check": "CONVEX_AGENT_MODE=anonymous convex dev --once",
		"convex:test": "vitest run --config vitest.config.ts",
		"convex:typecheck": "tsc --noEmit -p convex/tsconfig.json",
		"convex:prod-check": "node scripts/check-convex-production.mjs",
		"convex:related-check": "node scripts/check-related-metadata.mjs",
		"ops:test": "node --test scripts/check-related-metadata.test.mjs scripts/check-vercel-provenance.test.mjs",
		"deps:provenance": "node scripts/check-vercel-provenance.mjs",
		"next:dev": "convex dev --start \"pnpm -C nextjs dev\"",
		"next:build": "pnpm -C nextjs build",
		"next:lint": "pnpm -C nextjs lint",
		"next:grammar": "node nextjs/scripts/check-visual-grammar.mjs",
		"next:test": "pnpm -C nextjs test",
		"next:e2e": "pnpm -C nextjs e2e",
		"ingest:lint": "cd ingestion && uv run ruff check . && uv run ruff format --check .",
		"ingest:test": "cd ingestion && uv run python -m pytest",
		"ingest:sample": "cd ingestion && uv run python -m ingestion.cli ingest --sample",
		"ingest:run": "cd ingestion && uv run python -m ingestion.cli ingest"
	},
	"dependencies": {
		"convex": "^1.45.0"
	},
	"devDependencies": {
		"@edge-runtime/vm": "5.0.0",
		"@types/node": "^26.2.0",
		"convex-test": "0.0.56",
		"sigstore": "4.1.1",
		"typescript": "6.0.3",
		"vercel": "58.4.4",
		"vite": "8.2.2",
		"vitest": "4.1.2"
	}
}
