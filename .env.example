ENV=dev

# Public Next.js base URL for absolute links (set to https://betterman.sh in production)
PUBLIC_BASE_URL=http://localhost:3000

# Observability (optional, backend)
SENTRY_DSN=

# Convex-backed app runtime
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
CONVEX_SITE_URL=

# Rate-limit authentication: set the same private key in Next.js and Convex.
# Local: add RATE_LIMIT_TAG_KEY to root .env.local, export it before Next starts,
# (`set -a; . ./.env.local; set +a`), then
# run `npx convex env set RATE_LIMIT_TAG_KEY '<same-key>'` for the local deployment.
# Production: configure both Vercel and Convex before deploying these functions.
RATE_LIMIT_TAG_KEY=
# Optional Next-only local bypass, used only with an unset key outside production.
# Convex still requires a key and valid tag for every direct mutation call.
BETTERMAN_RATE_LIMIT_DEV_BYPASS=0

# Convex ingestion HTTP actions
CONVEX_HTTP_URL=
CONVEX_INGEST_SECRET=
BETTERMAN_DATASET_STAGE=staging

# Observability (optional, Next.js)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
