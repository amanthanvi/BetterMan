ENV=dev

# Public Next.js base URL for absolute links (set to https://betterman.sh in production)
PUBLIC_BASE_URL=http://localhost:3000

# Observability (optional, backend)
SENTRY_DSN=

# Proxy trust for accurate IP-based rate limiting (optional)
TRUSTED_PROXY_CIDRS=

# Convex-backed app runtime
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
# Convex HTTP actions URL; derived from a *.convex.cloud CONVEX_URL when unset
CONVEX_SITE_URL=
# Bearer token for the Convex /rate-limit/enforce action. Set the same value in
# the Convex deployment env; keep it distinct from CONVEX_INGEST_SECRET.
CONVEX_RATE_LIMIT_SECRET=

# Convex ingestion HTTP actions
CONVEX_HTTP_URL=
CONVEX_INGEST_SECRET=
BETTERMAN_DATASET_STAGE=staging

# Observability (optional, Next.js)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
