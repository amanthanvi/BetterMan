ENV=dev

# Public Next.js base URL for absolute links (set to https://betterman.sh in production)
PUBLIC_BASE_URL=http://localhost:3000

# Observability (optional, backend)
SENTRY_DSN=

# Proxy trust for accurate IP-based rate limiting (optional)
TRUSTED_PROXY_CIDRS=

# Convex-backed app runtime
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
CONVEX_SITE_URL=

# Rate-limit signing key: the same value on Next and Convex, or rate-limited
# routes return 429. Local/E2E: export it before starting Next and run
# `npx convex env set RATE_LIMIT_TAG_KEY <same value>` on the local deployment.
RATE_LIMIT_TAG_KEY=

# Convex ingestion HTTP actions
CONVEX_HTTP_URL=
CONVEX_INGEST_SECRET=
BETTERMAN_DATASET_STAGE=staging

# Observability (optional, Next.js)
NEXT_PUBLIC_SENTRY_DSN=
# Browser Sentry environment tag; falls back to NEXT_PUBLIC_VERCEL_ENV, then NODE_ENV
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Build/ops only; never expose the Stats API key with a NEXT_PUBLIC_ prefix.
# analytics:counts is a no-op without this key. Do not configure it in the browser.
PLAUSIBLE_API_KEY=
# Optional site ID override for the export; defaults to NEXT_PUBLIC_PLAUSIBLE_DOMAIN.
PLAUSIBLE_SITE_ID=
# Optional aggregate output path (default .plausible-counts.json).
PLAUSIBLE_COUNTS_OUTPUT=
