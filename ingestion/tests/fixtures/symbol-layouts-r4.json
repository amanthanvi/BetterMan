  {
    "name": "login.defs",
    "section": "5",
    "sourceHtmlSha256": "658225013e8f984a6a977a2f84162bd4b5f78d0640a93c0c0c6cecb4468cb5e4",
    "doc": {
      "toc": [],
      "blocks": [
        {
          "type": "heading",
          "id": "description",
          "level": 2,
          "text": "DESCRIPTION"
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "PASS_MAX_DAYS"
                }
              ]
            },
            {
              "type": "text",
              "text": " (number)"
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            [
              {
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "text",
                    "text": "The maximum number of days a password may be used. If the password is older than this, a password change will be forced. If not specified, -1 will be assumed (which disables the restriction)."
                  }
                ]
              }
            ]
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "PASS_MIN_DAYS"
                }
              ]
            },
            {
              "type": "text",
              "text": " (number)"
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            [
              {
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "text",
                    "text": "The minimum number of days allowed between password changes. Any password changes attempted sooner than this will be rejected. If not specified, 0 will be assumed (which disables the restriction)."
                  }
                ]
              }
            ]
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "PASS_WARN_AGE"
                }
              ]
            },
            {
              "type": "text",
              "text": " (number)"
            }
          ]
        },
        {
          "type": "list",
          "ordered": false,
          "items": [
            [
              {
                "type": "paragraph",
                "inlines": [
                  {
                    "type": "text",
                    "text": "The number of days warning given before a password expires. A zero means warning is given only upon the day of expiration, a value of -1 means no warning is given. If not specified, no warning will be provided."
                  }
                ]
              }
            ]
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "PASS_MAX_DAYS"
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "PASS_MIN_DAYS"
                }
              ]
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "PASS_WARN_AGE"
                }
              ]
            },
            {
              "type": "text",
              "text": " are only used at the time of account creation. Any changes to these settings won't affect existing accounts."
            }
          ]
        },
        {
          "type": "paragraph",
          "inlines": [
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "SHA_CRYPT_MIN_ROUNDS"
                }
              ]
            },
            {
              "type": "text",
              "text": " (number), "
            },
            {
              "type": "strong",
              "inlines": [
                {
                  "type": "text",
                  "text": "SHA_CRYPT_MAX_ROUNDS"
                }
              ]
            },
            {
              "type": "text",
              "text": " (number)"
            }
          ]
        }
      ]
    }
  }
