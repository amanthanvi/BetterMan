        {
          "type": "definition_list",
          "items": [
            {
              "id": "POSIXLY_CORRECT",
              "termInlines": [
                {
                  "type": "text",
                  "text": "POSIXLY_CORRECT"
                }
              ],
              "definitionBlocks": [
                {
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Determines the block size used by "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "-ls"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " and "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "-fls"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". If "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "POSIXLY_CORRECT"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " is set, blocks are units of 512 bytes. Otherwise they are units of 1024 bytes."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "symbols": [
      {
        "term": "POSIXLY_CORRECT",
        "anchorId": "POSIXLY_CORRECT",
        "excerpt": "Determines the block size used by -ls and -fls . If POSIXLY_CORRECT is set, blocks are units of 512 bytes. Otherwise they are units of 1024 bytes.",
        "kind": "environment"
      }
    ]
  }
