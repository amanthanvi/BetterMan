  {
    "name": "resolv.conf",
    "section": "5",
    "source": "/tmp/issue416/out/debian/html/resolv.conf.5.html.gz",
    "sourceHtmlSha256": "acbd6c7f1fb666a865d7d9f779dff1b585e236c5e51604f874272fa905de6151",
    "doc": {
      "toc": [],
      "blocks": [
        {
          "type": "heading",
          "id": "description",
          "level": 2,
          "text": "DESCRIPTION"
        },
        {
          "type": "definition_list",
          "items": [
            {
              "id": "nameserver",
              "termInlines": [
                {
                  "type": "strong",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "nameserver"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " Name server IP address"
                }
              ],
              "definitionBlocks": [
                {
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "Internet address of a name server that the resolver should query, either an IPv4 address (in dot notation), or an IPv6 address in colon (and possibly dot) notation as per RFC 2373. Up to "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "MAXNS"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " (currently 3, see "
                    },
                    {
                      "type": "emphasis",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "<resolv.h>"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ") name servers may be listed, one per keyword. If there are multiple servers, the resolver library queries them in the order listed. If no "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "nameserver"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " entries are present, the default is to use the name server on the local machine. (The algorithm used is to try a name server, and if the query times out, try the next, until out of name servers, then repeat trying all the name servers until a maximum number of retries are made.)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "search",
              "termInlines": [
                {
                  "type": "strong",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "search"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " Search list for host-name lookup."
                }
              ],
              "definitionBlocks": [
                {
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "By default, the search list contains one entry, the local domain name. It is determined from the local hostname returned by "
                    },
                    {
                      "type": "link",
                      "href": "/man/gethostname/2",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "gethostname(2)"
                        }
                      ],
                      "linkType": "internal"
                    },
                    {
                      "type": "text",
                      "text": "; the local domain name is taken to be everything after the first '.'. Finally, if the hostname does not contain a '.', the root domain is assumed as the local domain name."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "symbols": [
      {
        "term": "nameserver",
        "anchorId": "nameserver",
        "excerpt": "Internet address of a name server that the resolver should query, either an IPv4 address (in dot notation), or an IPv6 address in colon (and possibly dot) notat",
        "kind": "config"
      },
      {
        "term": "search",
        "anchorId": "search",
        "excerpt": "By default, the search list contains one entry, the local domain name. It is determined from the local hostname returned by gethostname(2) ; the local domain na",
        "kind": "config"
      }
    ]
  },
