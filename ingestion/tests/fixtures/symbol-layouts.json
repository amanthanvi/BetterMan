                    {
                      "type": "text",
                      "text": "motd file"
                    }
                  ]
                }
              ],
              "definitionBlocks": [
                {
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "This parameter allows you to specify a \"message of the day\" (MOTD) to display to clients on each connect. This usually contains site information and any legal notices. The default is no MOTD file. This can be overridden by the "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "--dparam=motdfile=FILE"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " command-line option when starting the daemon."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "id": "module-parameters",
          "level": 2,
          "text": "MODULE PARAMETERS"
        },
        {
          "type": "definition_list",
          "items": [
            {
              "id": "path",
              "termInlines": [
                {
                  "type": "strong",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "path"
                    }
                  ]
                }
              ],
              "definitionBlocks": [
                {
                  "type": "paragraph",
                  "inlines": [
                    {
                      "type": "text",
                      "text": "This parameter specifies the directory in the daemon's filesystem to make available in this module. You must specify this parameter for each module in "
                    },
                    {
                      "type": "strong",
                      "inlines": [
                        {
                          "type": "text",
                          "text": "rsyncd.conf"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "symbols": [
